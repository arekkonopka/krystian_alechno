---
import { navItems } from '../data/site';
import { withBase } from '../utils/paths';
import BrandLogo from '../components/BrandLogo.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	currentPath?: string;
}

const { title, description, currentPath = Astro.url.pathname } = Astro.props;
const siteUrl = Astro.site ?? new URL('https://example.com');
const canonicalUrl = new URL(withBase(currentPath), new URL(siteUrl).origin);
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#002430" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Przejdź do treści</a>
		<header class="site-header">
			<div class="container nav-shell">
				<a class="brand" href={withBase('/')} aria-label="Enflow Solutions — strona główna">
					<BrandLogo size="sm" />
				</a>
				<nav aria-label="Główna nawigacja">
					<ul class="nav-links">
						{navItems.map((item) => (
							<li><a class={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'active' : ''} href={withBase(item.href)}>{item.label}</a></li>
						))}
					</ul>
				</nav>
				<a class="button button-small button-outline-light nav-cta" href={withBase('/kontakt/')}>Porozmawiajmy <span aria-hidden="true">↗</span></a>
			</div>
		</header>
		<main id="main-content"><slot /></main>
		<footer class="site-footer">
			<div class="container footer-grid">
				<div>
					<a class="brand brand-footer" href={withBase('/')} aria-label="Enflow Solutions — strona główna">
						<BrandLogo size="md" />
					</a>
					<p class="footer-note">Energia dla przemysłu.</p>
				</div>
				<div>
					<p class="footer-label">Nawigacja</p>
					<ul class="footer-links">
						{navItems.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
					</ul>
				</div>
				<div>
					<p class="footer-label">Obszar działania</p>
					<p class="footer-note">Dolny Śląsk<br />i województwa ościenne</p>
				</div>
			</div>
			<div class="container footer-bottom"><span>© {new Date().getFullYear()} Enflow Solutions</span><a class="creator-credit" href="mailto:arekcommerce@gmail.com" aria-label="Created by Arkadiusz Konopka, arekcommerce@gmail.com">Created by Arkadiusz Konopka · arekcommerce@gmail.com</a></div>
		</footer>
	</body>
</html>
