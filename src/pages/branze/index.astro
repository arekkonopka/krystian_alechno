---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndustryIcon from '../../components/IndustryIcon.astro';
import { industries } from '../../data/site';
---

<BaseLayout title="Branże — Enflow Solutions" description="Rozwiązania energetyczne dla branży spożywczej, produkcyjnej oraz hal i magazynów.">
	<section class="page-hero"><div class="container page-hero-grid"><div><p class="eyebrow eyebrow-light"><span class="eyebrow-dot"></span> Branże</p><h1>Energia ma znaczenie <em>w każdym procesie.</em></h1><p>Wybierz obszar, który najlepiej opisuje Twój zakład. Zobacz, z jakimi wyzwaniami spotykamy się najczęściej i gdzie możemy szukać oszczędności.</p></div><div class="page-hero-mark" aria-hidden="true">03</div></div></section>
	<section class="section section-light"><div class="container"><div class="industry-list">{industries.map((industry, index) => <a class="industry-row" href={`/branze/${industry.slug}/`}><span class="row-number">0{index + 1}</span><span class="row-icon"><IndustryIcon type={industry.icon} /></span><span class="row-copy"><h2>{industry.shortTitle}</h2><p>{industry.description}</p></span><span class="row-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
</BaseLayout>
