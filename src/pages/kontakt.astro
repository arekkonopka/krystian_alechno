---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';

const description = 'Skontaktuj się z Enflow Solutions i opowiedz o swoim zakładzie, procesie oraz wyzwaniach energetycznych.';
---

<BaseLayout title="Kontakt — Enflow Solutions" description={description}>
	<section class="page-hero">
		<div class="container page-hero-grid">
			<div>
				<p class="eyebrow eyebrow-light"><span class="eyebrow-dot"></span> Kontakt</p>
				<h1>Zacznijmy od <em>konkretu.</em></h1>
				<p>Opowiedz nam krótko o zakładzie, procesie lub wyzwaniu. Wrócimy z pierwszymi pytaniami i propozycją kolejnego kroku.</p>
			</div>
			<div class="page-hero-mark" aria-hidden="true">↗</div>
		</div>
	</section>
	<section class="section section-light">
		<div class="container contact-grid">
			<div class="contact-details">
				<BrandLogo variant="dark" size="lg" />
				<p class="eyebrow"><span class="eyebrow-dot"></span> Enflow Solutions</p>
				<h2>Rozwiązania energetyczne dla firm z Dolnego Śląska i okolic.</h2>
				<p>Najlepiej znamy realia małych i średnich zakładów produkcyjnych, firm spożywczych oraz obiektów wielkokubaturowych.</p>
				<div class="contact-detail"><span>Obszar działania</span><strong>Dolny Śląsk + województwa ościenne</strong></div>
				<div class="contact-detail"><span>Najprostszy pierwszy krok</span><strong>30-minutowa rozmowa o zakładzie</strong></div>
			</div>
			<form class="contact-form" action="#" method="post">
				<div class="form-heading"><p>Pierwsza wiadomość</p></div>
				<label for="name">Imię i nazwisko <span>*</span></label>
				<input id="name" name="name" type="text" autocomplete="name" required placeholder="Jan Kowalski" />
				<label for="company">Firma</label>
				<input id="company" name="company" type="text" autocomplete="organization" placeholder="Nazwa firmy" />
				<label for="email">E-mail <span>*</span></label>
				<input id="email" name="email" type="email" autocomplete="email" required placeholder="jan@firma.pl" />
				<label for="message">O czym porozmawiamy?</label>
				<textarea id="message" name="message" rows="5" placeholder="Np. wysokie koszty ogrzewania hali, odzysk ciepła z procesu..."></textarea>
				<label class="consent"><input type="checkbox" name="consent" required /><span>Wyrażam zgodę na kontakt w sprawie mojego zapytania. <span>*</span></span></label>
				<button class="button button-dark button-submit" type="submit">Wyślij wiadomość <span aria-hidden="true">↗</span></button>
			</form>
		</div>
	</section>
</BaseLayout>
