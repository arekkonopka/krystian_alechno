---
import { withBase } from '../utils/paths';

interface Props { type: 'food' | 'production' | 'warehouse' | 'other'; }
const { type } = Astro.props;
const iconSources = {
	food: '/industry-food.png',
	production: '/industry-production.png',
	warehouse: '/industry-warehouse.png',
	other: '/industry-other.png',
} as const;
---

<img class="industry-icon industry-icon-image" src={withBase(iconSources[type])} alt="" aria-hidden="true" />
